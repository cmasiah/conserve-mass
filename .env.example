# ---- Conserve Mass Ops configuration ----
# Copy to /mnt/user/appdata/conserve-mass/.env and fill in.

# Public URL the browser uses to reach the app (your NPM hostname). No trailing slash.
BASE_URL=https://cmass.example.lan

# EVE developer application (https://developers.eveonline.com/applications)
# Callback URL there must be exactly: ${BASE_URL}/auth/callback
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
# Contact sent to CCP in the User-Agent header. CCP strongly prefers an email:
# it's how they reach you before throttling or banning an app.
ESI_CONTACT=you@example.com

# Character IDs allowed to log into the web UI (comma separated).
# Leave empty on first boot: the FIRST character to log in becomes admin.
ADMIN_CHARACTER_IDS=

# Your corporation ID (Conserve Mass). Leave blank to use the admin's corp.
CORPORATION_ID=

# Random secrets. Generate with:
#   openssl rand -base64 48 | tr -d '\n'; echo
SESSION_SECRET=
#   openssl rand -base64 32 | tr '+/' '-_'
TOKEN_ENCRYPTION_KEY=

# Discord bot (https://discord.com/developers/applications) — DMs you.
# The bot must share a server with you, and you must allow DMs from server members.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_USER_ID=

# Polling / alerts
# How often to check; ESI itself is only called when its ~5 min cache expires.
CONTRACT_POLL_SECONDS=60
EXPIRY_WARNING_HOURS=24
BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO

# Abuse protection
# Auto-mute an issuer who posts more than this many contracts in an hour
SPAM_CONTRACTS_PER_HOUR=10
# More than this many alerts of one kind waiting -> one digest DM instead
DIGEST_THRESHOLD=3
# Hard cap on Discord DMs per hour (extra alerts wait and get digested)
DISCORD_MAX_MESSAGES_PER_HOUR=30
# New location lookups per sync (each unknown structure is one ESI call)
MAX_LOCATION_LOOKUPS_PER_SYNC=25

# Copy to ".env" in the same folder as docker-compose.yml (NOT the app's .env in appdata).
# These are deployment settings for Docker Compose, kept local and never committed.

# Host port the web UI is published on
CMASS_PORT=8000
# Timezone for logs and the nightly backup schedule (EVE time is UTC either way)
TZ=UTC
# Where config, database, backups and the app's own .env live
CMASS_APPDATA=/mnt/user/appdata/conserve-mass
# Unraid defaults: nobody:users
PUID=99
PGID=100
